{
  "name": "llm-web",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "fastify": "^5.7.4"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.gerineldo.app",
    "productName": "Gerineldo",
    "files": [
      "main.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "asarUnpack": [
      "public/**/*"
    ],
    "win": {
      "target": {
        "target": "portable",
        "arch": ["x64"]
      }
    },
    "portable": {
      "artifactName": "Gerineldo.exe"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Gerineldo LLM frontend"
}
